---
import Page from "../layouts/Page.astro";
import Command from "../components/Command.astro";
import Demo from "../components/Demo.astro";
import Hud from "../components/Hud.astro";
import Meeting from "../components/Meeting.astro";
import { description, install, proof, sizes, topBlock, unblock } from "../copy";

const [dictation, meetings, freeFastLocal] = topBlock.pitch;
---

<Page title="andrew dictate · escape the keyboard." description={description}>
  <main>
    <!-- one column on every screen: the pitch, then the demo right under
         it, so the thing itself is never a long scroll away. -->
    <section class="column pb-16 pt-24 lg:pt-28">
      <div class="hero-intro">
        <div class="flex items-center gap-3">
          <img src="/badge.png" alt="" width="32" height="32" class="rounded-[7px]" />
          <div class="relative">
            <div class="name-row flex flex-wrap items-center gap-x-3 gap-y-1">
              <h1 class="text-[15px] font-medium leading-[1.35] text-gold-pale">
                <span class="wordmark">{topBlock.name}</span>
              </h1>
              <span
                class="-rotate-[4deg] rounded-[3px] bg-gold px-1 py-[2px] font-mono text-[9px] leading-none tracking-[0.14em] text-ink"
              >
                ALPHA
              </span>
            </div>
            <p class="text-[15px] text-cream/50">{topBlock.tagline}</p>
            <!-- out of the flow, so the hidden joke doesn't push the name off
                 the badge's centre -->
            <p class="aside absolute left-0 top-full whitespace-nowrap text-[12px] leading-[1.5]" aria-hidden="true">get it?</p>
          </div>
        </div>

        <p class="pitch mt-12">{dictation}</p>
        <p class="pitch-second mt-1">{meetings}</p>
        <p class="mt-5 font-mono text-[0.8125rem] tracking-[0.02em] text-gold">{freeFastLocal}</p>
      </div>

      <div class="mt-12">
        <Demo />
      </div>

      <div class="hero-why mt-14 space-y-4">
        {
          topBlock.why.map((line) => {
            // the claim links to where it is kept
            const [before, after] = line.split(proof);
            return after === undefined ? (
              <p class="prose-line">{line}</p>
            ) : (
              // on one line: a break here would put a space before the comma
              <p class="prose-line">{before}<a class="link" href="/changelog">{proof}</a>{after}</p>
            );
          })
        }
        <p class="prose-line">{topBlock.models}</p>
      </div>
    </section>

    <section class="column py-16">
      <h2 class="heading">hold <kbd>fn</kbd>, talk, let go.</h2>
      <div class="mt-6 space-y-4">
        <p class="prose-line">
          the text shows up where your cursor is, in any app. i mostly use it
          to talk to agents in a terminal.
        </p>
        <p class="prose-line">
          the model runs on your mac, so there's no wait for a server. it works
          offline too.
        </p>
        <p class="prose-line">
          if it keeps mishearing a word, add the word to the dictionary. or fix
          it twice and the app adds it for you.
        </p>
        <p class="prose-line">
          double-tap <kbd>fn</kbd> if you don't want to hold it. <kbd>esc</kbd>
          throws it away. if your keyboard eats <kbd>fn</kbd>, pick another key in
          settings.
        </p>
        <p class="fact pt-2">{sizes.dictation} to download. english, or 25 languages.</p>
      </div>
    </section>

    <!-- meetings are the smaller half, lower on the page. the scene comes
         before the facts, as the demo does. -->
    <section class="column py-16">
      <h2 class="heading">record a meeting.</h2>

      <div class="mt-6">
        <Meeting />
      </div>

      <div class="mt-10 space-y-4">
        <p class="prose-line">
          press record in the menu bar. it hears your mic and whatever your mac
          plays, so it gets both sides of the call.
        </p>
        <p class="prose-line">
          press stop and you get one markdown file that says who said what.
          point your agent at the folder and ask it what you agreed to.
        </p>
        <p class="prose-line">
          when a call starts, the app asks if you want it recorded. it never
          starts by itself.
        </p>
        <p class="fact pt-2">
          {sizes.meetings} to download. the call can be in any language whisper
          knows. the file comes out in english unless you change it.
        </p>
      </div>
    </section>

    <section id="install" class="column py-16">
      <div>
        <h2 class="heading">install.</h2>

        <div class="mt-8">
          <Command command={install} label="the install command" />
        </div>
        <p class="fact mt-3">for apple silicon macs on macOS 26. free, MIT.</p>

        <p class="prose-line mt-10">
          i'm broke, so i didn't pay apple $99 to sign this. run this once, and
          never again:
        </p>
        <div class="mt-4">
          <Command command={unblock} label="the unblock command" quiet />
        </div>
        <p class="prose-line mt-4">
          the second line opens it. a setup window comes up. after that it lives
          in your menu bar as the gold badge. there's no dock icon.
        </p>
        <p class="fact mt-4 max-w-[38rem]">
          no terminal? open the app, let macOS refuse, then click open anyway in
          system settings › privacy & security. that button is only there for
          about an hour.
        </p>

        <p class="prose-line mt-10">
          to update, run the same command with{" "}
          <span class="font-mono text-[0.9em] text-gold-pale">upgrade</span> instead of{" "}
          <span class="font-mono text-[0.9em] text-gold-pale">install</span>. the menu tells
          you when there's a new version.
        </p>
      </div>
    </section>
  </main>

  <Hud />

  <script>
    import "../demo/page";
  </script>
</Page>
