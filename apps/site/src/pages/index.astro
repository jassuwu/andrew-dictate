---
import "../styles/global.css";

const install = "brew install --cask jassuwu/tap/andrew-dictate";
const unquarantine =
  'xattr -dr com.apple.quarantine "/Applications/Andrew Dictate.app"\nopen "/Applications/Andrew Dictate.app"';

const compare = [
  { row: "price", ours: "free, forever", theirs: "free tier capped, pro $15/mo", src: "https://wisprflow.ai/pricing" },
  { row: "free tier", ours: "no limit", theirs: "2,000 words a week", src: "https://wisprflow.ai/pricing" },
  { row: "account", ours: "none", theirs: "required", src: "https://wisprflow.ai/pricing" },
  { row: "your voice", ours: "never leaves the mac", theirs: "transcribed in the cloud", src: "https://wisprflow.ai/privacy" },
  { row: "also sent", ours: "nothing", theirs: "text around your cursor, on-screen text, and a screenshot", src: "https://docs.wisprflow.ai/articles/4678293671-feature-context-awareness" },
  { row: "on a plane", ours: "works", theirs: "needs a connection", src: "https://docs.wisprflow.ai/articles/5094956927-fix-no-internet-connection-issues" },
  { row: "meetings", ours: "transcript written on your mac, audio kept there a day by default, then deleted", theirs: "notetaker, on the free tier", src: "https://wisprflow.ai/post/wispr-flow-notetaker" },
  { row: "source", ours: "MIT", theirs: "closed" },
  { row: "languages", ours: "english, or 25 languages · meetings in english by default, from any language whisper knows", theirs: "100+, auto-detected", src: "https://wisprflow.ai/" },
  { row: "platforms", ours: "macOS, apple silicon", theirs: "mac, windows, iphone, android", src: "https://wisprflow.ai/", them: true },
];

// every pair here is pinned by a test — CleanerTests.swift and
// SpokenEmailTests.swift carry a sync comment pointing back at this file, so
// the page can only ever claim what the cleaner actually does.
const rendered = [
  { heard: "hello comma how are you question mark", pasted: "Hello, how are you?" },
  { heard: "ping me at support at acme dot io tomorrow", pasted: "Ping me at support@acme.io tomorrow." },
  { heard: "um, I uh think erm, this uhm works", pasted: "Um, I uh think erm, this uhm works." },
];

// slack, x and imessage will not resolve a relative og:image — astro.config.mjs
// sets `site`, and a missing key fails the build here rather than shipping quietly.
const canonical = new URL("/", Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;

const description =
  "free, local dictation and meeting transcripts for macOS. hold fn, talk, let go. the speech models run on your mac. alpha, and honest about it.";
---

<html lang="en" class="bg-[#0c0c0e]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>andrew dictate — escape the keyboard.</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content="andrew dictate" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body class="bg-[#0c0c0e] text-[#f2ede0] antialiased">
    <main class="mx-auto flex min-h-screen max-w-[38rem] flex-col px-6 py-20 sm:py-28">
      <header>
        <img
          src="/badge.png"
          alt="andrew dictate app icon"
          width="72"
          height="72"
          class="rounded-[16px]"
        />

        <div class="name-row mt-6 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h1 class="text-[28px] font-semibold tracking-[-0.02em] text-[#f9e9a8]">
            <span class="wordmark">andrew dictate</span>
          </h1>
          <span
            class="-rotate-[4deg] rounded-[3px] bg-[#e5be62] px-1.5 py-[3px] font-mono text-[11px] leading-none tracking-[0.14em] text-[#0c0c0e]"
          >
            ALPHA
          </span>
        </div>

        <p class="mt-1.5 text-[15px] text-[#e5be62]">escape the keyboard.</p>
        <p class="aside text-[13px] leading-[1.7]" aria-hidden="true">get it?</p>

        <p class="mt-6 text-[15px] leading-[1.75] text-[#f2ede0]/70">
          speech to text for macOS, with the models on your mac. i made it
          because i wanted this without a subscription or my voice going to a
          server. i use it all day. it's alpha, and the rough parts are on this
          page.
        </p>
      </header>

      <section class="mt-10 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-[#f2ede0]/[0.08] bg-[#f2ede0]/[0.025] p-5">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#e5be62"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M2 10v4" /><path d="M6 6v12" /><path d="M10 3v18" /><path d="M14 8v8" /><path d="M18 5v14" /><path d="M22 10v4" />
          </svg>
          <h2 class="mt-4 text-[16px] font-semibold tracking-[-0.01em] text-[#f9e9a8]">dictate</h2>
          <p class="mt-2 text-[14px] leading-[1.7] text-[#f2ede0]/65">
            hold <kbd>fn</kbd>, talk, let go — or pick a different key in
            settings if yours eats fn. the text lands where your cursor is.
          </p>
          <!-- small-type floor on #0c0c0e: under 13px /65, 13px and up /55 -->
          <p class="mt-4 font-mono text-[11.5px] leading-[1.8] tracking-[0.02em] text-[#f2ede0]/65">
            ~460 mb · english, or 25 languages · a dictionary for the words it mishears
          </p>
        </div>

        <div class="rounded-xl border border-[#f2ede0]/[0.08] bg-[#f2ede0]/[0.025] p-5">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#e5be62"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><circle cx="17" cy="9" r="3" /><path d="M16 15.4a5.6 5.6 0 0 1 5.5 4.6" />
          </svg>
          <h2 class="mt-4 text-[16px] font-semibold tracking-[-0.01em] text-[#f9e9a8]">record a meeting</h2>
          <p class="mt-2 text-[14px] leading-[1.7] text-[#f2ede0]/65">
            press record in the menu bar. your mic is you, and whatever the
            mac plays is them. press stop and you have one markdown file with
            the speakers split out, written in english by the default model.
          </p>
          <p class="mt-4 font-mono text-[11.5px] leading-[1.8] tracking-[0.02em] text-[#f2ede0]/65">
            ~2.9 gb · audio kept a day by default, a thin transcript's until you delete it · you start it, you stop it
          </p>
        </div>
      </section>

      <section class="mt-10">
        <h2 class="text-[17px] font-semibold tracking-[-0.01em] text-[#f2ede0]">
          what it does to what you said
        </h2>

        <div class="mt-6 rounded-xl border border-[#f2ede0]/[0.08] bg-[#f2ede0]/[0.025] p-5">
          <div class="hidden grid-cols-[1fr_1.5rem_1fr] gap-x-3 border-b border-[#f2ede0]/10 pb-2 sm:grid">
            <span class="font-mono text-[11px] tracking-[0.1em] text-[#f2ede0]/65">heard</span>
            <span></span>
            <span class="font-mono text-[11px] tracking-[0.1em] text-[#e5be62]/80">pasted</span>
          </div>

          <div class="divide-y divide-[#f2ede0]/[0.07]">
            {
              rendered.map((r) => (
                <div class="grid gap-x-3 py-3.5 sm:grid-cols-[1fr_1.5rem_1fr]">
                  <p class="font-mono text-[14px] leading-[1.6] text-[#f2ede0]/55">
                    <span class="mr-2 text-[10px] tracking-[0.1em] text-[#f2ede0]/65 sm:hidden">heard</span>
                    {r.heard}
                  </p>
                  <span aria-hidden="true" class="hidden text-center font-mono text-[14px] leading-[1.6] text-[#f2ede0]/55 sm:block">
                    →
                  </span>
                  <p class="mt-1.5 font-mono text-[14px] leading-[1.6] text-[#f2ede0] sm:mt-0">
                    <span class="mr-2 text-[10px] tracking-[0.1em] text-[#e5be62]/80 sm:hidden">pasted</span>
                    {r.pasted}
                  </p>
                </div>
              ))
            }
          </div>

          <p class="mt-4 text-[14px] leading-[1.7] text-[#f2ede0]/60">
            no model rewrote that. it's the same words, written down.
          </p>
        </div>
      </section>

      <section class="mt-10">
        <button
          data-cmd={install}
          class="copy flex w-full items-start justify-between gap-4 rounded-lg border border-[#f2ede0]/10 bg-[#1f1f24] px-4 py-3 text-left font-mono text-[12px] leading-[1.6] text-[#f9e9a8] transition hover:border-[#e5be62]/40 sm:text-[13px]"
        >
          <span>{install}</span>
          <span class="hint shrink-0 text-[11px] text-[#f2ede0]/65" aria-live="polite">copy</span>
        </button>

        <p class="mt-3 font-mono text-[12px] tracking-[0.02em] text-[#f2ede0]/65">
          apple silicon · macOS 26 · free forever · MIT
        </p>

        <p class="mt-5 text-[14px] leading-[1.7] text-[#f2ede0]/60">
          updating later is the same command with <span class="font-mono text-[13px]">upgrade</span> instead of <span class="font-mono text-[13px]">install</span>. you won't need the line below again.
        </p>

        <div class="mt-7">
          <p class="text-[14px] leading-[1.7] text-[#f2ede0]/60">
            the build is unsigned, because i haven't paid apple the $99 for a
            developer membership. so it needs this once, and never again:
          </p>
          <button
            data-cmd={unquarantine}
            class="copy mt-3 flex w-full items-start justify-between gap-4 rounded-lg border border-[#f2ede0]/[0.07] bg-[#f2ede0]/[0.02] px-4 py-3 text-left font-mono text-[11.5px] leading-[1.6] text-[#e5be62]/90 transition hover:border-[#e5be62]/30 sm:text-[12px]"
          >
            <span class="whitespace-pre-line">{unquarantine}</span>
            <span class="hint shrink-0 text-[11px] text-[#f2ede0]/65" aria-live="polite">copy</span>
          </button>
          <p class="mt-3 text-[14px] leading-[1.7] text-[#f2ede0]/60">
            the second line opens it. there's no dock icon — a setup window comes
            up, and after that it lives as the gold badge in your menu bar.
          </p>
          <p class="mt-3 font-mono text-[12px] leading-[1.7] tracking-[0.02em] text-[#f2ede0]/45">
            no terminal? open the app, let macOS refuse, then click open anyway in
            system settings › privacy & security. that button is only there for
            about an hour.
          </p>
        </div>
      </section>

      <section class="mt-14">
        <h2 class="text-[17px] font-semibold tracking-[-0.01em] text-[#f2ede0]">
          where your words go
        </h2>
        <p class="mt-4 text-[15px] leading-[1.75] text-[#f2ede0]/70">
          nowhere. the app goes online in three places: downloading a speech model at setup, the <span class="font-mono text-[13px]">check for updates</span> button, which asks github for the latest version, and a check once a day that sends this site the version you're running and nothing else. a switch in settings turns that last one off. i add each of those checks to a count per version per day and keep nothing else from it: no ip address, no user agent, no id. no account, no crash reports, no usage tracking. your dictations are kept in a local history you can switch off or wipe.
        </p>
      </section>

      <section class="mt-14">
        <h2 class="text-[17px] font-semibold tracking-[-0.01em] text-[#f2ede0]">
          against the one everyone pays for
        </h2>

        <div class="mt-6 hidden grid-cols-[7.5rem_1fr_1fr] gap-x-5 border-b border-[#f2ede0]/10 pb-2 sm:grid">
          <span></span>
          <span class="font-mono text-[11px] tracking-[0.1em] text-[#e5be62]">andrew dictate</span>
          <span class="font-mono text-[11px] tracking-[0.1em] text-[#f2ede0]/65">wispr flow</span>
        </div>

        <dl class="divide-y divide-[#f2ede0]/[0.07]">
          {
            compare.map((c) => (
              <div class="grid gap-x-5 py-3.5 sm:grid-cols-[7.5rem_1fr_1fr]">
                <dt class="text-[13px] text-[#f2ede0]/55 sm:text-[14px]">{c.row}</dt>

                <dd
                  class:list={[
                    "mt-1.5 text-[14px] leading-[1.6] sm:mt-0",
                    c.them ? "text-[#f2ede0]/55" : "text-[#f9e9a8]",
                  ]}
                >
                  <span class="mr-2 font-mono text-[10px] tracking-[0.1em] text-[#e5be62]/80 sm:hidden">
                    ours
                  </span>
                  {c.ours}
                </dd>

                <dd class="mt-1 text-[14px] leading-[1.6] text-[#f2ede0]/55 sm:mt-0">
                  <span class="mr-2 font-mono text-[10px] tracking-[0.1em] text-[#f2ede0]/65 sm:hidden">
                    theirs
                  </span>
                  {c.src ? (
                    <a
                      href={c.src}
                      class="underline decoration-dotted decoration-[#f2ede0]/15 underline-offset-4 transition hover:decoration-[#e5be62]"
                    >
                      {c.theirs}
                    </a>
                  ) : (
                    c.theirs
                  )}
                </dd>
              </div>
            ))
          }
        </dl>      </section>

      <footer class="mt-auto pt-20">
        <nav class="flex flex-wrap items-baseline gap-x-6 gap-y-2 text-[14px]">
          <a class="text-[#e5be62] transition hover:text-[#f9e9a8]" href="https://github.com/jassuwu/andrew-dictate">github</a>
          <a class="text-[#e5be62] transition hover:text-[#f9e9a8]" href="https://github.com/jassuwu/andrew-dictate/releases">releases</a>
          <a class="hand text-[16px] text-[#e5be62] transition hover:text-[#f9e9a8]" href="https://jass.gg">made by jass</a>
        </nav>
      </footer>
    </main>

    <script>
      document.querySelectorAll<HTMLButtonElement>("button.copy").forEach((button) => {
        const hint = button.querySelector(".hint");
        button.addEventListener("click", async () => {
          const cmd = button.getAttribute("data-cmd");
          if (!cmd || !hint) return;
          await navigator.clipboard.writeText(cmd);
          hint.textContent = "copied";
          setTimeout(() => (hint.textContent = "copy"), 1600);
        });
      });
    </script>
  </body>
</html>
