---
import "../styles/global.css";

const install = "brew install --cask jassuwu/tap/andrew-dictate";
const unquarantine =
  'xattr -dr com.apple.quarantine "/Applications/Andrew Dictate.app"';

const compare = [
  { row: "price", ours: "free, forever", theirs: "free tier capped, pro $15/mo", src: "https://wisprflow.ai/pricing" },
  { row: "free tier", ours: "no limit", theirs: "2,000 words a week", src: "https://wisprflow.ai/pricing" },
  { row: "account", ours: "none", theirs: "required", src: "https://wisprflow.ai/pricing" },
  { row: "your voice", ours: "never leaves the mac", theirs: "transcribed in the cloud", src: "https://wisprflow.ai/privacy" },
  { row: "also sent", ours: "nothing", theirs: "text around your cursor, on-screen text, and a screenshot", src: "https://docs.wisprflow.ai/articles/4678293671-feature-context-awareness" },
  { row: "on a plane", ours: "works", theirs: "needs a connection", src: "https://docs.wisprflow.ai/articles/5094956927-fix-no-internet-connection-issues" },
  { row: "source", ours: "MIT, ~10k lines you can read", theirs: "closed" },
  { row: "languages", ours: "english", theirs: "100+, auto-detected", src: "https://wisprflow.ai/", them: true },
  { row: "platforms", ours: "macOS, apple silicon", theirs: "mac, windows, iphone, android", src: "https://wisprflow.ai/", them: true },
  { row: "meeting notes", ours: "not yet", theirs: "notetaker, on the free tier", src: "https://wisprflow.ai/post/wispr-flow-notetaker", them: true },
];

const description =
  "a free, fully local dictation app for macOS. hold fn, speak, release, and your text appears wherever the cursor is. alpha, and honest about it.";
---

<html lang="en" class="bg-[#0c0c0e]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>andrew dictate — escape the keyboard.</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <meta property="og:title" content="andrew dictate" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="bg-[#0c0c0e] text-[#f2ede0] antialiased">
    <main class="mx-auto flex min-h-screen max-w-[38rem] flex-col px-6 py-20 sm:py-28">
      <header>
        <img
          src="/badge.png"
          alt="andrew dictate app icon"
          width="72"
          height="72"
          class="rounded-[16px]"
        />

        <div class="name-row mt-6 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h1 class="text-[28px] font-semibold tracking-[-0.02em] text-[#f9e9a8]">
            <span class="wordmark">andrew dictate</span>
          </h1>
          <span
            class="-rotate-[4deg] rounded-[3px] bg-[#e5be62] px-1.5 py-[3px] font-mono text-[11px] font-bold leading-none tracking-[0.14em] text-[#0c0c0e]"
          >
            ALPHA
          </span>
        </div>

        <p class="mt-1.5 text-[15px] text-[#e5be62]">escape the keyboard.</p>
        <p class="aside text-[13px] leading-[1.7]" aria-hidden="true">yes. like that.</p>

        <p class="mt-6 text-[15px] leading-[1.75] text-[#f2ede0]/70">
          a dictation app for macOS. hold <kbd>fn</kbd>, speak, release. your text
          appears wherever the cursor is, a few hundred milliseconds after you let
          go. the speech model ships inside the app and runs on your mac, so
          nothing you say leaves the machine. no account, no subscription.
        </p>
      </header>

      <section class="mt-9">
        <button
          data-cmd={install}
          class="copy flex w-full items-start justify-between gap-4 rounded-lg border border-[#f2ede0]/10 bg-[#1f1f24] px-4 py-3 text-left font-mono text-[12px] leading-[1.6] text-[#f9e9a8] transition hover:border-[#e5be62]/40 sm:text-[13px]"
        >
          <span>{install}</span>
          <span class="hint shrink-0 text-[11px] text-[#f2ede0]/55" aria-live="polite">copy</span>
        </button>

        <p class="mt-3 text-[13px] text-[#f2ede0]/45">
          apple silicon · macOS 14+ · free forever · MIT
        </p>

        <div class="mt-7">
          <p class="text-[14px] leading-[1.7] text-[#f2ede0]/60">
            builds are unsigned, because i haven't paid apple the $99 for a
            developer membership. so the first launch needs right-click → open, or
            this once:
          </p>
          <button
            data-cmd={unquarantine}
            class="copy mt-3 flex w-full items-start justify-between gap-4 rounded-lg border border-[#f2ede0]/[0.07] bg-[#f2ede0]/[0.02] px-4 py-3 text-left font-mono text-[11.5px] leading-[1.6] text-[#e5be62]/90 transition hover:border-[#e5be62]/30 sm:text-[12px]"
          >
            <span>{unquarantine}</span>
            <span class="hint shrink-0 text-[11px] text-[#f2ede0]/45" aria-live="polite">copy</span>
          </button>
        </div>
      </section>


      <section class="mt-16">
        <h2 class="text-[17px] font-semibold tracking-[-0.01em] text-[#f2ede0]">
          against the one everyone pays for
        </h2>

        <div class="mt-6 hidden grid-cols-[7.5rem_1fr_1fr] gap-x-5 border-b border-[#f2ede0]/10 pb-2 sm:grid">
          <span></span>
          <span class="font-mono text-[11px] tracking-[0.1em] text-[#e5be62]">andrew dictate</span>
          <span class="font-mono text-[11px] tracking-[0.1em] text-[#f2ede0]/40">wispr flow</span>
        </div>

        <dl class="divide-y divide-[#f2ede0]/[0.07]">
          {
            compare.map((c) => (
              <div class="grid gap-x-5 py-3.5 sm:grid-cols-[7.5rem_1fr_1fr]">
                <dt class="text-[13px] text-[#f2ede0]/40 sm:text-[14px]">{c.row}</dt>

                <dd
                  class:list={[
                    "mt-1.5 text-[14px] leading-[1.6] sm:mt-0",
                    c.them ? "text-[#f2ede0]/55" : "text-[#f9e9a8]",
                  ]}
                >
                  <span class="mr-2 font-mono text-[10px] tracking-[0.1em] text-[#e5be62]/60 sm:hidden">
                    ours
                  </span>
                  {c.ours}
                </dd>

                <dd class="mt-1 text-[14px] leading-[1.6] text-[#f2ede0]/55 sm:mt-0">
                  <span class="mr-2 font-mono text-[10px] tracking-[0.1em] text-[#f2ede0]/30 sm:hidden">
                    theirs
                  </span>
                  {c.src ? (
                    <a
                      href={c.src}
                      class="underline decoration-dotted decoration-[#f2ede0]/15 underline-offset-4 transition hover:decoration-[#e5be62]"
                    >
                      {c.theirs}
                    </a>
                  ) : (
                    c.theirs
                  )}
                </dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-5 text-[13px] leading-[1.7] text-[#f2ede0]/45">
          the last three rows go to them, and i'm not going to pretend otherwise.
          every claim about wispr flow links to their own site or docs, checked
          21 august 2026. speed is missing on purpose: i haven't measured it
          properly yet, so there's nothing honest to put there.
        </p>
      </section>

      <footer class="mt-auto pt-20">
        <p class="text-[20px] font-semibold tracking-[-0.02em] text-[#f9e9a8]">
          typing is for brokies.
        </p>

        <nav class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[14px]">
          <a class="text-[#e5be62] transition hover:text-[#f9e9a8]" href="https://github.com/jassuwu/andrew-dictate">github</a>
          <a class="text-[#e5be62] transition hover:text-[#f9e9a8]" href="https://github.com/jassuwu/andrew-dictate#roadmap">roadmap</a>
          <a class="text-[#e5be62] transition hover:text-[#f9e9a8]" href="https://github.com/jassuwu/andrew-dictate/releases">releases</a>
          <a class="text-[#e5be62] transition hover:text-[#f9e9a8]" href="https://jass.gg">made by jass</a>
        </nav>

        <p class="mt-8 text-[13px] text-[#f2ede0]/30">the matrix wants you typing.</p>
      </footer>
    </main>

    <script>
      document.querySelectorAll<HTMLButtonElement>("button.copy").forEach((button) => {
        const hint = button.querySelector(".hint");
        button.addEventListener("click", async () => {
          const cmd = button.getAttribute("data-cmd");
          if (!cmd || !hint) return;
          await navigator.clipboard.writeText(cmd);
          hint.textContent = "copied";
          setTimeout(() => (hint.textContent = "copy"), 1600);
        });
      });
    </script>
  </body>
</html>
