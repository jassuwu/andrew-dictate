---
import pairs from "../demo/pairs.json";

// with scripts off the visitor sees the end of a take: a prompt landed in
// the agent's box. with them on, the box starts empty and waits for the key.
const first = pairs.prompts[0];
const landed = first.cuts[first.cuts.length - 1].pasted;
---

<div data-demo>
  <div class="agent">
    <p class="agent-head">agent</p>
    <div class="agent-thread" data-thread></div>
    <div class="composer" data-box aria-live="polite">
      <span class="composer-mark" aria-hidden="true">❯</span>
      <span data-box-text><noscript>{landed}</noscript></span>
    </div>
  </div>

  <!-- hidden until the script that makes them work has loaded -->
  <div data-controls hidden>
  <div class="mt-4 flex items-center gap-4">
    <button
      type="button"
      class="key"
      data-key
      aria-label="hold to dictate. the demo says a prompt for you."
    >
      fn
    </button>
    <p class="speech">
      <span data-hint>
        <span class="with-keys">hold <kbd>space</kbd>, or hold this key.</span>
        <span class="without-keys">hold this key.</span>{" "}
        the demo does the talking.
      </span>
      <span data-said hidden aria-hidden="true"></span>
    </p>
    <button type="button" class="sound" data-sound aria-pressed="true">sound on</button>
  </div>

  <p class="fact mt-5 text-cream/45">
    it's a simulation, but the pause after you let go is as long as the
    real app's.
  </p>
  </div>

  <!-- the page always says what this is, the key working or not -->
  <noscript>
    <p class="fact mt-5 text-cream/45">
      a simulation, shown at its end. with scripts on, you hold a key and the text lands.
    </p>
  </noscript>
</div>
