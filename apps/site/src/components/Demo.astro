---
// a loop from the launch film, drawn, never a recording of the real app.
// silent, so it can play by itself; the page's script plays it while it is
// on screen and leaves it still for reduced motion. without scripts it has
// controls and waits to be played.
interface Props {
  name: string;
  label: string;
}

const { name, label } = Astro.props;
---

<figure class="film">
  <video
    poster={`/film/${name}.jpg`}
    width="1600"
    height="900"
    muted
    loop
    playsinline
    preload="metadata"
    controls
    aria-label={label}
    data-film
  >
    <!-- vp9 first, h.264 for whatever cannot play it -->
    <source src={`/film/${name}.webm`} type="video/webm" />
    <source src={`/film/${name}.mp4`} type="video/mp4" />
  </video>
</figure>
