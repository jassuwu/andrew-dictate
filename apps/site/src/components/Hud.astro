---
// the app's one floating panel, where the app puts it: bottom centre. the
// lamp lives here, and so does the pill, and neither takes a click.
---

<div class="hud" aria-hidden="true">
  <canvas data-lamp></canvas>
</div>
<p class="pill" data-pill hidden aria-hidden="true"></p>
<!-- what the pill says, for a screen reader: always here, so it is heard -->
<p class="sr-only" role="status" data-pill-status></p>
