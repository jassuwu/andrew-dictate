---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = "/" } = Astro.props;

// slack, x and imessage will not resolve a relative og:image. astro.config.mjs
// sets `site`, and a missing key fails the build here rather than shipping
// quietly.
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const github = "https://github.com/jassuwu/andrew-dictate";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content="andrew dictate" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body class="antialiased">
    <!-- the app lives as a badge in the menu bar, so the page has one -->
    <header class="menubar">
      <nav
        class="column flex h-full items-center justify-between font-mono text-[12.5px]"
      >
        <div class="flex items-center gap-5 text-cream/65">
          <a class="transition-colors hover:text-gold-pale" href="/#install">install</a>
          <a class="transition-colors hover:text-gold-pale" href="/changelog">changelog</a>
          <a class="transition-colors hover:text-gold-pale" href={github}>github</a>
        </div>
        <a href="/" aria-label="andrew dictate, home" class="badge" data-badge>
          <img src="/menubar.png" alt="" width="18" height="18" />
        </a>
      </nav>
    </header>

    <slot />

    <footer class="column pb-28 pt-16">
      <nav class="flex flex-wrap items-baseline gap-x-6 gap-y-2 text-[14px]">
        <a class="link" href={github}>github</a>
        <a class="link" href={`${github}/releases`}>releases</a>
        <a class="link" href="/changelog">changelog</a>
        <a class="hand text-[16px] text-gold transition-colors hover:text-gold-pale" href="https://jass.gg">
          made by jass
        </a>
      </nav>
    </footer>

    <script>
      document.querySelectorAll<HTMLElement>(".cmd").forEach((block) => {
        const button = block.querySelector("button");
        const code = block.querySelector("code");
        if (!button || !code) return;
        // the button is in the markup for everyone and only works with
        // scripts on; without them the command is still there to select.
        button.hidden = false;
        const label = button.getAttribute("aria-label") ?? "copy";
        button.addEventListener("click", async () => {
          await navigator.clipboard.writeText(code.textContent ?? "");
          button.textContent = "copied";
          button.setAttribute("aria-label", "copied");
          setTimeout(() => {
            button.textContent = "copy";
            button.setAttribute("aria-label", label);
          }, 1600);
        });
      });
    </script>
  </body>
</html>
